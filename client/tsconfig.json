{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "paths": {
      "@utils/*": [
        "utils/*"
      ],
      "@models/*": [
        "models/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@repositories/*": [
        "repositories/*"
      ],
      "@data/*": [
        "data/*"
      ],
      "@presentation/*": [
        "presentation/*"
      ],
      "@pages/*": [
        "presentation/pages/*"
      ],
      "@components/*": [
        "presentation/components/*"
      ],
    }
  },
  "include": [
    "src"
  ]
}