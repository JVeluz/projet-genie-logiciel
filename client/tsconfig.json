{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "paths": {
      "@utils/*": [
        "utils/*"
      ],
      "@models/*": [
        "models/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@data/*": [
        "data/*"
      ],
      "@presentation/*": [
        "presentation/*"
      ],
      "@controllers/*": [
        "presentation/controllers/*"
      ],
      "@elements/*": [
        "presentation/elements/*"
      ],
      "@html/*": [
        "presentation/html/*"
      ],
    }
  },
  "include": [
    "src"
  ]
}