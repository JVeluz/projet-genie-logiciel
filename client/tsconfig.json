{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext", // ou "commonjs"
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@controllers/*": [
        "controllers/*"
      ],
      "@core/*": [
        "core/*"
      ],
      "@elements/*": [
        "elements/*"
      ],
      "@html/*": [
        "html/*"
      ],
      "@models/*": [
        "models/*"
      ],
      "@services/*": [
        "services/*"
      ],
    }
  },
  "include": [
    "src"
  ]
}